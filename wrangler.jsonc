// Hébergement du site vitrine chez Cloudflare (remplace GitHub Pages).
{
  "name": "referee-tracker-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // "none" : on garde les adresses en .html déjà connues de Google (pas de redirection)
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
